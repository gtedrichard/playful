<div class="auth-wrap">
  <div class="auth-card">
    <h1>Reset password</h1>
    <p class="auth-sub">Choose a new password for your account.</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-status form-status--err" style="margin-bottom:14px">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="np">New password</label><input class="input" id="np" type="password" name="customer[password]" required></div>
      <div class="field"><label for="npc">Confirm password</label><input class="input" id="npc" type="password" name="customer[password_confirmation]" required></div>
      <button type="submit" class="btn btn--coral btn--block btn--lg">Reset password →</button>
    {%- endform -%}
  </div>
</div>
