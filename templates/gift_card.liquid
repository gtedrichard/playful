{% layout 'theme' %}

<div class="kk-gift-card">
  <div class="kk-gift-card-inner kk-reveal">
    <div class="kk-gift-card-visual">
      <div class="kk-gift-card-visual-dd"></div>
      <div class="kk-gift-card-logo">
        <div style="width:32px;height:32px;background:var(--kk-yellow);border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--kk-ink);font-size:16px;font-weight:900;">K</div>
        KeepKase
      </div>
      <div class="kk-gift-card-amount">{{ gift_card.initial_value | money_without_trailing_zeros }}</div>
      <div class="kk-gift-card-num">{{ gift_card.code | format_code }}</div>
    </div>

    <h1 class="kk-gift-card-title">KeepKase Gift Card</h1>
    <p class="kk-gift-card-sub">
      {%- if gift_card.enabled -%}
        {%- if gift_card.expired -%}
          This gift card has expired.
        {%- else -%}
          Balance: <strong>{{ gift_card.balance | money }}</strong>
          {%- if gift_card.expires_on -%} · Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}{%- endif -%}
        {%- endif -%}
      {%- else -%}
        This gift card has been disabled.
      {%- endif -%}
    </p>

    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href="{{ shop.url }}" class="kk-btn kk-btn-filled">Shop now →</a>
      <button class="kk-btn kk-btn-ghost" onclick="navigator.clipboard.writeText('{{ gift_card.code }}');this.textContent='Copied!';">Copy code</button>
    </div>

    {%- if gift_card.pass_url -%}
      <div style="margin-top:24px;">
        <a href="{{ gift_card.pass_url }}" style="display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--kk-blue);font-weight:600;text-decoration:none;">
          🍎 Add to Apple Wallet
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
