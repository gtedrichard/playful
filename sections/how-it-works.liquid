<section class="h11 rv">
  <div class="h11-cross" aria-hidden="true"></div>
  <div class="wrap">
    <div class="h11-ey">{{ section.settings.eyebrow | default: 'How it works' }}</div>
    <h2 class="h11-title">{{ section.settings.title | default: 'Three steps to <span class="hs">freedom.</span>' }}</h2>
    <div class="h11-stack">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="hc rv d{{ forloop.index }}" data-draggable {{ block.shopify_attributes }}>
            <div class="hc-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
            {%- if block.settings.image != blank -%}
              <div class="hc-img" style="border-style:solid;padding:0"><img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" style="width:100%;height:100%;object-fit:cover;border-radius:10px"></div>
            {%- else -%}
              <div class="hc-img"><div class="hc-img-d"></div><div class="hc-img-i">{{ block.settings.emoji | default: '📸' }}</div><div class="hc-img-l">Step {{ forloop.index }} photo</div><div class="hc-img-s">4:3</div></div>
            {%- endif -%}
            <h4>{{ block.settings.title }}</h4><p>{{ block.settings.text }}</p>
            {%- if block.settings.tag != blank -%}<div class="hc-tag"><span class="tag {% if block.settings.tag_style == 'blue' %}tag--b{% else %}tag--ghost{% endif %}">{{ block.settings.tag }}</span></div>{%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="hc rv d1" data-draggable><div class="hc-num">01</div><div class="hc-img"><div class="hc-img-d"></div><div class="hc-img-i">📸</div><div class="hc-img-l">Step 1 photo</div><div class="hc-img-s">4:3</div></div><h4>Place your stickers</h4><p>Lay them between the two clear sheets. No adhesive touches your MacBook — ever.</p><div class="hc-tag"><span class="tag tag--ghost">Zero adhesive</span></div></div>
        <div class="hc rv d2" data-draggable><div class="hc-num">02</div><div class="hc-img"><div class="hc-img-d"></div><div class="hc-img-i">📸</div><div class="hc-img-l">Step 2 photo</div><div class="hc-img-s">4:3</div></div><h4>Snap in the frame</h4><p>The hardshell border clips around your MacBook and holds the sheet sandwich in place.</p><div class="hc-tag"><span class="tag tag--ghost">Full protection</span></div></div>
        <div class="hc rv d3" data-draggable><div class="hc-num">03</div><div class="hc-img"><div class="hc-img-d"></div><div class="hc-img-i">📸</div><div class="hc-img-l">Step 3 photo</div><div class="hc-img-s">4:3</div></div><h4>Swap or retire</h4><p>Pop the sheets out. Rearrange. Retire a layout to your wall. Start fresh whenever.</p><div class="hc-tag"><span class="tag tag--ghost">Keep forever ✦</span></div></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "richtext", "id": "title", "label": "Title", "default": "<p>Three steps to <em>freedom.</em></p>" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "emoji", "label": "Placeholder emoji", "default": "📸" },
      { "type": "text", "id": "title", "label": "Title", "default": "Place your stickers" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Lay them between the two clear sheets. No adhesive touches your MacBook — ever." },
      { "type": "text", "id": "tag", "label": "Tag", "default": "Zero adhesive" },
      { "type": "select", "id": "tag_style", "label": "Tag style", "options": [ { "value": "ghost", "label": "Outline" }, { "value": "blue", "label": "Blue" } ], "default": "ghost" }
    ] }
  ],
  "presets": [{ "name": "How it works" }]
}
{% endschema %}
