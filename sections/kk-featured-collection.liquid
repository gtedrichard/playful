<section class="kk-related kk-reveal" style="background:{{ section.settings.bg | default: '#F4F1EA' }};">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:32px;">
      <h2 class="kk-related-title">{{ section.settings.title | default: section.settings.collection.title | default: 'Featured products.' }}</h2>
      {%- if section.settings.show_view_all and section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="kk-view-all">View all →</a>
      {%- endif -%}
    </div>
    <div class="kk-product-grid" style="--kk-cols:{{ section.settings.columns | default: 3 }};">
      {%- assign col = section.settings.collection -%}
      {%- if col != blank -%}
        {%- for product in col.products limit: section.settings.products_to_show | default: 3 -%}
          <div class="kk-product-card">
            <a href="{{ product.url }}" style="text-decoration:none;color:inherit;">
              <div class="kk-product-card-img">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="300" height="300">
                {%- else -%}
                  <div class="kk-product-card-img-placeholder"><div class="kk-product-card-img-placeholder-icon">📦</div><div class="kk-product-card-img-placeholder-label">{{ product.title }}</div></div>
                {%- endif -%}
                {%- if product.compare_at_price > product.price -%}
                  <div class="kk-product-card-badge">Sale</div>
                {%- endif -%}
              </div>
              <div class="kk-product-card-body">
                <div class="kk-product-card-vendor">{{ product.vendor }}</div>
                <div class="kk-product-card-title">{{ product.title }}</div>
                <div class="kk-product-card-price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="kk-product-card-price-compare">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
            <div class="kk-product-card-footer">
              {%- if product.available -%}
                <button class="kk-product-card-atc" data-product-id="{{ product.variants.first.id }}">Add to cart</button>
              {%- else -%}
                <button class="kk-product-card-atc sold-out" disabled>Sold out</button>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="kk-product-card"><div class="kk-product-card-img"><div class="kk-product-card-img-placeholder"><div class="kk-product-card-img-placeholder-icon">📦</div><div class="kk-product-card-img-placeholder-label">Product {{ i }}</div></div></div><div class="kk-product-card-body"><div class="kk-product-card-title">KeepKase Case</div><div class="kk-product-card-price">$79</div></div><div class="kk-product-card-footer"><button class="kk-product-card-atc">Add to cart</button></div></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 3 },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ]},
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F4F1EA" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
