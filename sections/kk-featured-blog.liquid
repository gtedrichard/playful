<section class="kk-featured-blog kk-reveal">
  <div class="kk-featured-blog-header">
    <h2 class="kk-featured-blog-title">{{ section.settings.title | default: 'From the team.' }}</h2>
    {%- if section.settings.blog != blank -%}
      <a href="{{ section.settings.blog.url }}" class="kk-view-all">All posts →</a>
    {%- endif -%}
  </div>
  <div class="kk-blog-grid">
    {%- if section.settings.blog != blank -%}
      {%- for article in section.settings.blog.articles limit: section.settings.posts_to_show | default: 3 -%}
        <a href="{{ article.url }}" class="kk-blog-card">
          <div class="kk-blog-card-img">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy" width="400" height="225">
            {%- else -%}
              <div style="height:100%;display:flex;align-items:center;justify-content:center;background:rgba(26,26,26,.04);padding:32px;text-align:center;"><div style="font-size:28px;">📝</div></div>
            {%- endif -%}
          </div>
          <div class="kk-blog-card-body">
            {%- if article.tags.first -%}
              <div class="kk-blog-card-tag">{{ article.tags.first }}</div>
            {%- endif -%}
            <div class="kk-blog-card-title">{{ article.title }}</div>
            <div class="kk-blog-card-excerpt">{{ article.excerpt | strip_html | truncate: 100 }}</div>
            <div class="kk-blog-card-meta">
              <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
              <span>{{ article.author }}</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <div class="kk-blog-card"><div class="kk-blog-card-img"><div style="height:180px;display:flex;align-items:center;justify-content:center;background:rgba(26,26,26,.04);"><div style="font-size:28px;">📝</div></div></div><div class="kk-blog-card-body"><div class="kk-blog-card-tag">Update</div><div class="kk-blog-card-title">Blog post {{ i }} title goes here</div><div class="kk-blog-card-excerpt">A preview of what you've been working on. Connect your blog in the customizer.</div><div class="kk-blog-card-meta"><span>March 2026</span></div></div></div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured blog",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "From the team." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 6, "step": 1, "label": "Posts to show", "default": 3 }
  ],
  "presets": [{ "name": "Featured blog" }]
}
{% endschema %}
