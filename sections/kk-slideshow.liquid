<section class="kk-slideshow kk-reveal" id="kk-ss-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="kk-slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
      <div class="kk-slide-bg">
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.heading | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" style="width:100%;height:100%;object-fit:cover;opacity:{{ block.settings.overlay_opacity | default: 0.5 }};">
        {%- else -%}
          <div style="width:100%;height:100%;background:{{ block.settings.bg_color | default: '#1A1A1A' }};"></div>
        {%- endif -%}
      </div>
      <div class="kk-slide-content">
        {%- if block.settings.eyebrow != blank -%}
          <div class="kk-slide-eyebrow">{{ block.settings.eyebrow }}</div>
        {%- endif -%}
        <h2 class="kk-slide-title">{{ block.settings.heading | default: 'Your stickers deserve better.' }}</h2>
        {%- if block.settings.subheading != blank -%}
          <p class="kk-slide-subtitle">{{ block.settings.subheading }}</p>
        {%- endif -%}
        {%- if block.settings.btn_text != blank -%}
          <a href="{{ block.settings.btn_url | default: '#' }}" class="kk-btn kk-btn-yellow">{{ block.settings.btn_text }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="kk-slide active"><div class="kk-slide-bg"><div style="width:100%;height:100%;background:#1A1A1A;"></div></div><div class="kk-slide-content"><div class="kk-slide-eyebrow">Alpha open</div><h2 class="kk-slide-title">Your stickers deserve better.</h2><p class="kk-slide-subtitle">30 alpha spots. $50 cost price.</p><a href="#tracks" class="kk-btn kk-btn-yellow">Claim yours →</a></div></div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="kk-slide-dots">
      {%- for block in section.blocks -%}
        <button class="kk-slide-dot{% if forloop.first %} active{% endif %}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
    <div class="kk-slide-arrows">
      <button class="kk-slide-arrow kk-slide-prev" aria-label="Previous">←</button>
      <button class="kk-slide-arrow kk-slide-next" aria-label="Next">→</button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Slideshow",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "color", "id": "bg_color", "label": "Background color (no image)", "default": "#1A1A1A" },
        { "type": "range", "id": "overlay_opacity", "min": 0, "max": 1, "step": 0.05, "label": "Image overlay opacity", "default": 0.5 },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Your stickers deserve better." },
        { "type": "text", "id": "subheading", "label": "Subheading" },
        { "type": "text", "id": "btn_text", "label": "Button text" },
        { "type": "url", "id": "btn_url", "label": "Button URL" }
      ]
    }
  ],
  "presets": [{ "name": "Slideshow", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
