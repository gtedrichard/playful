{%- comment -%} resync 2026-06-06 {%- endcomment -%}
{%- liquid
  assign total = settings.alpha_total | default: '100'
  assign remaining = all_products['keepkase-alpha'].selected_or_first_available_variant.inventory_quantity | default: 100
  assign menu = section.settings.menu
-%}

{%- if section.settings.announcement_show -%}
  <div class="annc">
    <span>
      {%- if section.settings.announcement_text != blank -%}
        {{ section.settings.announcement_text }}
      {%- else -%}
        Alpha testing is open — {{ total }} spots. {{ remaining }} left.
      {%- endif -%}
    </span>
    {%- if section.settings.announcement_link != blank and section.settings.announcement_link_text != blank -%}
      <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_link_text }} →</a>
    {%- elsif settings.discord_url != blank -%}
      <a href="{{ settings.discord_url }}" target="_blank" rel="noopener">Join the Discord →</a>
    {%- endif -%}
  </div>
{%- endif -%}

<nav class="nav" role="navigation" aria-label="Primary">
  <a class="logo" id="logoEl" href="{{ routes.root_url }}">
    <span class="logo-k"><img src="{{ 'keepkase-mark-ink.png' | asset_url }}" alt="KeepKase"></span>{{ shop.name | default: 'KeepKase' }}
  </a>

  <div class="nav-links">
    <a class="nl{% if request.path == routes.root_url %} on{% endif %}" href="{{ routes.root_url }}">Home</a>
    <a class="nl{% if request.path contains '/products/' %} on{% endif %}" href="/products/keepkase-alpha">Alpha test</a>
    <a class="nl{% if request.path contains '/blogs/' %} on{% endif %}" href="/blogs/journal">Journal</a>
    {%- if settings.discord_url != blank -%}<a class="nl" href="{{ settings.discord_url }}" target="_blank" rel="noopener">Join Discord</a>{%- endif -%}
  </div>

  <div class="nav-right">
    <a class="nav-icon" href="{{ routes.search_url }}" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </a>
    <a class="nav-icon" href="{{ routes.account_url }}" aria-label="Account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </a>
    <button class="nav-icon" data-cart-open aria-label="Open cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="cart-count" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
    </button>
    <a class="nav-btn" href="{{ section.settings.cta_link | default: '/products/keepkase-alpha' }}">{{ section.settings.cta_text | default: 'Get early access' }} →</a>
    <button class="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="MobileMenu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="MobileMenu" role="dialog" aria-modal="true" aria-label="Navigation menu">
  <a href="{{ routes.root_url }}">Home</a>
  <a href="/products/keepkase-alpha">Alpha test</a>
  <a href="/blogs/journal">Journal</a>
  {%- if settings.discord_url != blank -%}<a href="{{ settings.discord_url }}" target="_blank" rel="noopener">Join Discord</a>{%- endif -%}
  <a href="{{ routes.account_url }}">Account</a>
  <a class="btn btn--coral btn--block" href="{{ section.settings.cta_link | default: '/products/keepkase-alpha' }}">{{ section.settings.cta_text | default: 'Get early access' }} →</a>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Announcement bar" },
    { "type": "checkbox", "id": "announcement_show", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "announcement_text", "label": "Announcement text", "info": "Leave blank to auto-build from the Alpha settings." },
    { "type": "text", "id": "announcement_link_text", "label": "Announcement link text", "default": "Claim a spot" },
    { "type": "text", "id": "announcement_link", "label": "Announcement link", "default": "/products/keepkase-alpha" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Get early access" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "/products/keepkase-alpha" }
  ]
}
{% endschema %}
