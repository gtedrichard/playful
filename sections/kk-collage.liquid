<section class="kk-collage kk-reveal">
  {%- if section.settings.title != blank -%}
    <h2 class="kk-collage-title">{{ section.settings.title }}</h2>
  {%- endif -%}
  <div class="kk-collage-grid">
    {%- for block in section.blocks -%}
      <div class="kk-collage-item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.alt | default: 'KeepKase' }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
        {%- else -%}
          <div class="kk-collage-item-ph">
            <div style="font-size:24px;">{{ block.settings.placeholder_icon | default: '📸' }}</div>
            <div style="font-size:11px;font-weight:700;color:rgba(26,26,26,.3);">{{ block.settings.placeholder_label | default: 'Image' }}</div>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- for i in (1..5) -%}
        <div class="kk-collage-item"><div class="kk-collage-item-ph"><div style="font-size:24px;">📸</div><div style="font-size:11px;font-weight:700;color:rgba(26,26,26,.3);">Collage photo {{ i }}</div></div></div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collage",
  "settings": [
    { "type": "text", "id": "title", "label": "Title" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "placeholder_icon", "label": "Placeholder icon", "default": "📸" },
        { "type": "text", "id": "placeholder_label", "label": "Placeholder label", "default": "Photo" }
      ]
    }
  ],
  "presets": [{ "name": "Collage" }]
}
{% endschema %}
