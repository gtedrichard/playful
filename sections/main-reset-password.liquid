<div class="kk-auth-wrap kk-reveal">
  <div class="kk-auth-title">Reset password.</div>
  <div class="kk-auth-sub">We'll send you an email to reset your password.</div>
  <div class="kk-auth-card">
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}
        <div class="kk-success">✓ Email sent. Check your inbox.</div>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="kk-error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="kk-form-group">
        <label class="kk-form-label">Email</label>
        <input class="kk-form-input" type="email" name="email" autocomplete="email" required>
      </div>
      <button type="submit" class="kk-form-submit" style="margin-bottom:16px;">Send reset link →</button>
      <div style="text-align:center;">
        <a href="{{ routes.account_login_url }}" class="kk-auth-link">← Back to sign in</a>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
