<div class="page-head">
  <div class="dotgrid" aria-hidden="true"></div>
  <div class="wrap">
    <span class="eyebrow">Shop</span>
    <h1 style="margin-top:10px">{{ collection.title | default: 'The alpha' }}</h1>
    {%- if collection.description != blank -%}<p class="dek">{{ collection.description | strip_html | truncatewords: 40 }}</p>{%- endif -%}
  </div>
</div>

<section class="section bg-cream">
  <div class="wrap">
    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by 12 -%}
      <div class="blog-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="tl-empty" style="max-width:700px;margin:0 auto"><p style="font-weight:800;font-size:18px;color:var(--ink)">Nothing here yet.</p><p style="margin-top:8px">Add products to this collection in Shopify admin.</p></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
