<div class="pr12 rv">
  <div class="pr12-cross" aria-hidden="true"></div>
  <div class="wrap">
    <p class="pr12-text">
      <span class="prw">{{ section.settings.line1 | default: 'Designed' }} </span><span class="prc pr-serif">{{ section.settings.line1_serif | default: 'for' }}</span><br>
      <span class="pr-stroke">{{ section.settings.line2 | default: 'what you' }} </span><span class="prb"> {{ section.settings.line2_b | default: 'keep.' }}</span>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Promise",
  "settings": [
    { "type": "text", "id": "line1", "label": "Line 1 (solid)", "default": "Designed" },
    { "type": "text", "id": "line1_serif", "label": "Line 1 (serif accent)", "default": "for" },
    { "type": "text", "id": "line2", "label": "Line 2 (outline)", "default": "what you" },
    { "type": "text", "id": "line2_b", "label": "Line 2 (blue)", "default": "keep." }
  ],
  "presets": [{ "name": "Promise" }]
}
{% endschema %}
