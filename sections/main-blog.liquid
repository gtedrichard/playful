<div class="page-head">
  <div class="dotgrid" aria-hidden="true"></div>
  <div class="wrap">
    <span class="eyebrow">{{ blog.title | default: 'Devlog' }}</span>
    <h1 style="margin-top:10px">Building in the open.</h1>
    <p class="dek">Decisions, tradeoffs, and the occasional dead end.</p>
  </div>
</div>

<section class="section bg-cream">
  <div class="wrap">
    {%- if blog.articles.size > 0 -%}
      {%- paginate blog.articles by 12 -%}
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <a class="post-card" href="{{ article.url }}">
            <div class="post-cover">
              {%- if article.image -%}<img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">{%- else -%}<div class="placeholder-media" style="height:100%;border:none;border-radius:0;background:transparent"><div class="pm-i">📓</div></div>{%- endif -%}
            </div>
            <div class="post-body">
              <div class="post-meta">{{ article.published_at | date: '%b %-d, %Y' }}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</div>
              <h3>{{ article.title }}</h3>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              <span class="post-readmore">Read →</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="pagination">{{ paginate | default_pagination }}</div>
      {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="tl-empty" style="max-width:700px;margin:0 auto">
        <p style="font-weight:800;font-size:18px;color:var(--ink)">No posts yet.</p>
        <p style="margin-top:8px">Create a blog named <strong>devlog</strong> in Shopify admin and add posts — or use the baked <a href="/pages/devlog" style="color:var(--b);text-decoration:underline">Devlog page</a>.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
