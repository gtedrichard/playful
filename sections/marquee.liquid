<div class="mq {% if section.settings.style != 'yellow' %}mq--{{ section.settings.style }}{% endif %}" aria-hidden="true">
  <div class="mq-t">
    {%- assign reps = 2 -%}
    {%- for i in (1..reps) -%}
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <span class="mi" {{ block.shopify_attributes }}><span class="md"></span>{{ block.settings.text }}</span>
        {%- endfor -%}
      {%- else -%}
        <span class="mi"><span class="md"></span>Swap your layout</span>
        <span class="mi"><span class="md"></span>Keep your stickers</span>
        <span class="mi"><span class="md"></span>No adhesive on your MacBook</span>
        <span class="mi"><span class="md"></span>Retire sheets as wall art</span>
        <span class="mi"><span class="md"></span>Alpha now open</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    { "type": "select", "id": "style", "label": "Color", "options": [
      { "value": "yellow", "label": "Yellow" }, { "value": "ink", "label": "Ink" }, { "value": "blue", "label": "Blue" }
    ], "default": "yellow" }
  ],
  "blocks": [
    { "type": "item", "name": "Phrase", "settings": [ { "type": "text", "id": "text", "label": "Phrase", "default": "No adhesive, ever" } ] }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
