{%- comment -%} resync 2026-06-06 {%- endcomment -%}
{%- liquid
  assign total = settings.alpha_total | default: '100'
  assign remaining = product.selected_or_first_available_variant.inventory_quantity | default: 100
  assign current = product.selected_or_first_available_variant
  assign email = settings.support_email | default: 'hello@keepkase.com'
-%}
<section class="product rv" id="buy">
  <div class="dotgrid" aria-hidden="true" style="opacity:.5"></div>
  <div class="product-grid">

    {%- comment -%} ── Gallery ── {%- endcomment -%}
    <div class="gallery">
      {%- if product.featured_media -%}
        <div class="gallery-main">
          <img data-gallery-main src="{{ product.featured_media | image_url: width: 1100 }}" alt="{{ product.featured_media.alt | escape | default: product.title }}" width="1100">
        </div>
        {%- if product.media.size > 1 -%}
          <div class="gallery-thumbs">
            {%- for media in product.media limit: 8 -%}
              <button class="gthumb{% if forloop.first %} active{% endif %}" data-gallery-thumb data-src="{{ media | image_url: width: 1100 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ media | image_url: width: 200 }}" alt="" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="gallery-main gallery-main--mock">
          <div id="macDrag" class="mb-wrap">
            <div class="sw">Swap anytime ✦</div>
            <div class="mbf"><div class="mbs"><div class="mb-sheet">
              <div class="sk" style="width:48px;height:48px;background:#fff3cd;font-size:1.2rem;">🌿</div>
              <div class="sk" style="width:42px;height:42px;background:#cce5ff;font-size:1.2rem;">⚡</div>
              <div class="sk" style="width:58px;height:34px;background:#f8d7da;border-radius:16px;font-size:.6rem;font-weight:700;color:#444;">✦ vibes</div>
              <div class="sk" style="width:36px;height:48px;background:#e2d9f3;font-size:1.2rem;">🎸</div>
              <div class="sk" style="width:46px;height:46px;background:#d4edda;border-radius:50%;font-size:1.2rem;">🌙</div>
              <div class="sk" style="width:52px;height:32px;background:#fff3cd;font-size:.58rem;font-weight:700;color:#444;">BKL 2024</div>
            </div></div><div class="mb-notch"></div></div>
          </div>
        </div>
        <p class="gallery-cap">The swap mechanic — real product photos coming soon.</p>
      {%- endif -%}
    </div>

    {%- comment -%} ── Buy box (lean — essentials only) ── {%- endcomment -%}
    <div class="buybox">
      <span class="bb-badge"><span class="blink"></span> Founding alpha &middot; {{ remaining }} of {{ total }} left</span>
      <h1 class="bb-title">KeepKase <span class="serif" style="color:var(--c)">Alpha.</span></h1>
      <p class="bb-sub">{{ section.settings.subtitle | default: "A thin hardshell that holds the stickers you'd hate to lose — no adhesive, fully swappable." }}</p>

      <div class="bb-buy">
        <div class="bb-price-row">
          <span class="bb-price">{% render 'price', product: product %}</span>
          <span class="bb-price-l">founding price<br>ships {{ settings.ship_window | default: 'Fall 2026' }}</span>
        </div>
        {%- assign claimed_pct = 100 | minus: remaining -%}
        <div class="bb-scarcity">
          <div class="bb-bar"><span style="width:{{ claimed_pct }}%"></span></div>
          <div class="bb-bar-l"><strong>{{ remaining }}</strong> of {{ total }} spots left</div>
        </div>

      <form data-cart-form data-product-form method="post" action="{{ routes.cart_add_url }}">
        <input type="hidden" name="id" value="{{ current.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign is_color = false -%}
            {%- if option.name contains 'Color' or option.name contains 'Colour' or option.name contains 'colorway' -%}{%- assign is_color = true -%}{%- endif -%}
            <div class="variant-group">
              <div class="variant-label">{{ option.name }} <span class="vl-pick">{{ option.selected_value }}</span></div>
              <div class="swatches" data-option-index="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  {%- assign vd = value | downcase -%}
                  {%- assign dot = '#cccccc' -%}
                  {%- if vd contains 'bone' -%}{%- assign dot = '#EDE6D6' -%}{%- elsif vd contains 'graphite' -%}{%- assign dot = '#3A3A3A' -%}{%- elsif vd contains 'ember' -%}{%- assign dot = '#B5654A' -%}{%- elsif vd contains 'signal' -%}{%- assign dot = '#1A8FFF' -%}{%- elsif vd contains 'white' or vd contains 'bone' -%}{%- assign dot = '#F4F1EA' -%}{%- elsif vd contains 'black' or vd contains 'ink' -%}{%- assign dot = '#1A1A1A' -%}{%- endif -%}
                  <label class="swatch">
                    <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                    {%- if is_color -%}<span class="sw-dot" style="background:{{ dot }}"></span>{%- endif -%}
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="buy-row" style="margin-top:8px">
          <div class="qty" aria-label="Quantity">
            <button type="button" data-qty="dec" aria-label="Decrease">–</button>
            <input type="text" name="quantity" value="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" data-qty="inc" aria-label="Increase">+</button>
          </div>
          <button type="submit" class="btn btn--coral btn--lg" data-add-label="{{ section.settings.add_label | default: 'Join the Alpha' }}"{% unless current.available %} disabled{% endunless %}>
            {%- if current.available -%}{{ section.settings.add_label | default: 'Join the Alpha' }}{%- else -%}Sold out{%- endif -%} →
          </button>
        </div>
      </form>

        <a href="{{ section.settings.waitlist_link | default: '/#email' }}" class="btn btn--ghost btn--block btn--sm" style="margin-top:2px">Not yet? Join the free waitlist →</a>
      </div>

      <p class="buy-note">3D-printed alpha · questions at <a href="mailto:{{ email }}">{{ email }}</a></p>
    </div>
  </div>

  <script type="application/json" data-variants-json>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"price":{{ v.price }},"available":{{ v.available }},"options":{{ v.options | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
</section>

{%- comment -%} ── Full product detail — ONE optional accordion (was four) ── {%- endcomment -%}
{%- if product.description != blank -%}
<section class="section">
  <div class="wrap wrap--narrow">
    <details class="faq-item">
      <summary>Full details <span class="faq-q-icon">+</span></summary>
      <div class="faq-a">{{ product.description }}</div>
    </details>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "add_label", "label": "Add-to-cart label", "default": "Join the Alpha" },
    { "type": "text", "id": "waitlist_link", "label": "Waitlist link", "default": "/#email" },
    { "type": "text", "id": "perks_title", "label": "Perks heading", "default": "What your alpha spot includes" },
    { "type": "richtext", "id": "in_box", "label": "In the box" },
    { "type": "richtext", "id": "alpha_details", "label": "The honest version" }
  ]
}
{% endschema %}
