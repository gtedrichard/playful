{%- assign reverse = section.settings.reverse -%}
<div class="kk-image-text kk-section{% if reverse %} reversed{% endif %} kk-reveal">
  <div class="kk-image-text-img">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" width="600" height="500" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
    {%- else -%}
      <div class="kk-image-text-img-ph" style="height:100%;min-height:400px;">
        <div style="font-size:32px;">📸</div>
        <div style="font-size:11px;font-weight:700;color:rgba(26,26,26,.3);">{{ section.settings.image_placeholder | default: 'Image · 4:3' }}</div>
      </div>
    {%- endif -%}
  </div>
  <div class="kk-image-text-body">
    {%- if section.settings.eyebrow != blank -%}
      <div class="kk-image-text-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2 class="kk-image-text-title">{{ section.settings.heading | default: 'Built different.' }}</h2>
    <div class="kk-image-text-body-text">{{ section.settings.text | default: 'Every sheet is UV-stabilized polycarbonate with anti-fingerprint hard coat. Clear enough to show every sticker. Strong enough to protect it.' }}</div>
    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_url | default: '#' }}" class="kk-btn kk-btn-filled">{{ section.settings.btn_text }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_placeholder", "label": "Image placeholder label", "default": "Image · 4:3" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout (image right)", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built different." },
    { "type": "richtext", "id": "text", "label": "Body text", "default": "<p>Every sheet is UV-stabilized polycarbonate with anti-fingerprint hard coat.</p>" },
    { "type": "text", "id": "btn_text", "label": "Button text" },
    { "type": "url", "id": "btn_url", "label": "Button URL" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
