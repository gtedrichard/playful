{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <section class="kk-related kk-reveal">
    <h2 class="kk-related-title">{{ section.settings.title | default: 'You might also like.' }}</h2>
    <div class="kk-product-grid">
      {%- for product in recommendations.products -%}
        <div class="kk-product-card">
          <a href="{{ product.url }}" style="text-decoration:none;color:inherit;">
            <div class="kk-product-card-img">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="300" height="300">
              {%- else -%}
                <div class="kk-product-card-img-placeholder"><div class="kk-product-card-img-placeholder-icon">📦</div></div>
              {%- endif -%}
            </div>
            <div class="kk-product-card-body">
              <div class="kk-product-card-title">{{ product.title }}</div>
              <div class="kk-product-card-price">{{ product.price | money }}</div>
            </div>
          </a>
          <div class="kk-product-card-footer">
            <button class="kk-product-card-atc{% unless product.available %} sold-out{% endunless %}">
              {%- if product.available %}Add to cart{% else %}Sold out{% endif -%}
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "You might also like." },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 6, "step": 1, "label": "Products to show", "default": 3 }
  ]
}
{% endschema %}
