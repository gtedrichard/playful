{%- liquid
  assign total = settings.alpha_total | default: '100'
  assign remaining = settings.alpha_remaining | default: '87'
-%}
<section class="hero">
  <svg class="tex" style="top:0;left:0;width:100%;height:100%;opacity:.06;" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs><pattern id="dots" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1.5" fill="#1A1A1A"/></pattern></defs>
    <rect width="100%" height="100%" fill="url(#dots)"/>
  </svg>
  <svg class="tex" style="left:0;top:0;height:100%;width:90px;opacity:.065;" preserveAspectRatio="xMidYMid slice" viewBox="0 0 90 600" aria-hidden="true">
    <path id="sqHL1" d="M15 0 Q38 50 15 100 Q-8 150 15 200 Q38 250 15 300 Q-8 350 15 400 Q38 450 15 500 Q-8 550 15 600" stroke="#1A1A1A" stroke-width="2.5" fill="none"/>
    <path id="sqHL2" d="M42 0 Q65 50 42 100 Q19 150 42 200 Q65 250 42 300 Q19 350 42 400 Q65 450 42 500 Q19 550 42 600" stroke="#1A1A1A" stroke-width="1.8" fill="none"/>
    <path id="sqHL3" d="M68 20 Q85 70 68 120 Q51 170 68 220 Q85 270 68 320 Q51 370 68 420 Q85 470 68 520" stroke="#1A1A1A" stroke-width="1.2" fill="none"/>
  </svg>

  <div class="hero-left">
    <div class="hero-lattice" aria-hidden="true"></div>
    <div class="hero-lc">
      <div class="hero-ey">
        <div class="pill pill--y"><span class="blink"></span>Alpha open — {{ total }} spots</div>
        <div class="pill pill--ghost">{{ remaining }} left</div>
      </div>
      <h1 class="hero-h1">
        {{ section.settings.heading_pre | default: 'The case stays.' }}<br>
        <span class="h1s">{{ section.settings.heading_serif | default: 'The story' }}</span>
        <span class="h1u">{{ section.settings.heading_post | default: 'swaps.' }}</span>
      </h1>
      <p class="hero-sub">{{ section.settings.subheading | default: 'A thin hardshell that holds two clear sheets over your stickers — no adhesive on the laptop. Swap a layout anytime, or retire one as a keepsake.' }}</p>
      <div class="hero-btns">
        <a href="{{ section.settings.cta1_link | default: '/products/keepkase-alpha' }}" class="btn btn--blue">{{ section.settings.cta1_text | default: 'Claim alpha spot — $50' }}</a>
        <a href="{{ section.settings.cta2_link | default: '/pages/community' }}" class="btn btn--ghost">{{ section.settings.cta2_text | default: 'Reserve free spot' }}</a>
      </div>
    </div>
  </div>

  <div class="hero-right">
    <div class="hr-c1" aria-hidden="true"></div><div class="hr-c2" aria-hidden="true"></div><div class="hr-dots" aria-hidden="true"></div>
    <svg class="tex" style="right:0;top:0;height:100%;width:80px;opacity:.11;" preserveAspectRatio="xMidYMid slice" viewBox="0 0 80 600" aria-hidden="true">
      <path id="sqHR1" d="M20 0 Q50 50 20 100 Q-10 150 20 200 Q50 250 20 300 Q-10 350 20 400 Q50 450 20 500 Q-10 550 20 600" stroke="white" stroke-width="2" fill="none"/>
      <path id="sqHR2" d="M50 30 Q75 80 50 130 Q25 180 50 230 Q75 280 50 330 Q25 380 50 430 Q75 480 50 530" stroke="white" stroke-width="1.4" fill="none"/>
    </svg>

    {%- if section.settings.hero_image != blank -%}
      <div class="mb-wrap" id="macDrag" style="width:auto;max-width:440px">
        <img src="{{ section.settings.hero_image | image_url: width: 880 }}" alt="KeepKase on a MacBook" width="440">
      </div>
    {%- else -%}
      <div id="macDrag" class="mb-wrap">
        <div class="sw">Swap anytime ✦</div>
        <div class="mbf"><div class="mbs"><div class="mb-sheet">
          <div class="sk" id="sk1" style="width:48px;height:48px;background:#fff3cd;font-size:1.2rem;">🌿</div>
          <div class="sk" id="sk2" style="width:42px;height:42px;background:#cce5ff;font-size:1.2rem;">⚡</div>
          <div class="sk" id="sk3" style="width:58px;height:34px;background:#f8d7da;border-radius:16px;font-size:.6rem;font-weight:700;color:#444;">✦ vibes</div>
          <div class="sk" id="sk4" style="width:36px;height:48px;background:#e2d9f3;font-size:1.2rem;">🎸</div>
          <div class="sk" id="sk5" style="width:46px;height:46px;background:#d4edda;border-radius:50%;font-size:1.2rem;">🌙</div>
          <div class="sk" id="sk6" style="width:52px;height:32px;background:#fff3cd;font-size:.58rem;font-weight:700;color:#444;">BKL 2024</div>
        </div></div><div class="mb-notch"></div></div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading_pre", "label": "Heading line 1", "default": "The case stays." },
    { "type": "text", "id": "heading_serif", "label": "Heading line 2 (serif accent)", "default": "The story" },
    { "type": "text", "id": "heading_post", "label": "Heading line 2 (underlined)", "default": "swaps." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A thin hardshell that holds two clear sheets over your stickers — no adhesive on the laptop. Swap a layout anytime, or retire one as a keepsake." },
    { "type": "text", "id": "cta1_text", "label": "Primary button text", "default": "Claim alpha spot — $50" },
    { "type": "url", "id": "cta1_link", "label": "Primary button link", "default": "/products/keepkase-alpha" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button text", "default": "Reserve free spot" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link", "default": "/pages/community" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (optional — replaces the sticker mock)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
