<div class="kk-marquee">
  <div class="kk-marquee-track">
    {%- for block in section.blocks -%}
      <div class="kk-marquee-item">
        <div class="kk-marquee-dot"></div>
        {{ block.settings.text }}
      </div>
    {%- else -%}
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Swap your layout</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Keep your stickers</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>No adhesive on your MacBook</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Retire sheets as wall art</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Alpha now open</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Built in Berkeley</div>
    {%- endfor -%}
    {%- for block in section.blocks -%}
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>{{ block.settings.text }}</div>
    {%- else -%}
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Swap your layout</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Keep your stickers</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>No adhesive on your MacBook</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Retire sheets as wall art</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Alpha now open</div>
      <div class="kk-marquee-item"><div class="kk-marquee-dot"></div>Built in Berkeley</div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee strip",
  "blocks": [
    {
      "type": "item",
      "name": "Marquee item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Swap your layout" }
      ]
    }
  ],
  "presets": [{
    "name": "Marquee strip",
    "blocks": [
      { "type": "item", "settings": { "text": "Swap your layout" } },
      { "type": "item", "settings": { "text": "Keep your stickers" } },
      { "type": "item", "settings": { "text": "No adhesive on your MacBook" } },
      { "type": "item", "settings": { "text": "Retire sheets as wall art" } },
      { "type": "item", "settings": { "text": "Alpha now open" } },
      { "type": "item", "settings": { "text": "Built in Berkeley" } }
    ]
  }]
}
{% endschema %}
