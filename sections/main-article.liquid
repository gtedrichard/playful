<div class="page-head">
  <div class="dotgrid" aria-hidden="true"></div>
  <div class="wrap wrap--narrow">
    <div class="breadcrumbs"><a href="{{ blog.url }}">{{ blog.title }}</a><span class="sep">/</span><span>{{ article.title }}</span></div>
    <div class="post-meta" style="margin-bottom:14px">{{ article.published_at | date: '%b %-d, %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</div>
    <h1>{{ article.title }}</h1>
  </div>
</div>

<section class="section bg-cream">
  <div class="article" style="padding-top:0">
    {%- if article.image -%}
      <div class="story-media" style="aspect-ratio:16/9;margin-bottom:32px"><img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" style="width:100%;height:100%;object-fit:cover"></div>
    {%- endif -%}
    <div class="prose">{{ article.content }}</div>
    <div class="row gap-3 mt-8" style="flex-wrap:wrap;border-top:2px solid var(--ink-12);padding-top:24px">
      <a href="{{ blog.url }}" class="btn btn--ghost btn--sm">← All posts</a>
      <a href="/products/keepkase-alpha" class="btn btn--ink btn--sm">Claim an alpha spot →</a>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
